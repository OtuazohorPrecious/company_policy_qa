# Copy this file to .env and fill in your key. Never commit .env.
OPENAI_API_KEY=your-openai-api-key-here

# Optional settings (defaults shown)
PORT=8000
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
TOP_K=5
# Change 1: sections sent to the model when a question is split into sub-questions
TOP_K_SPLIT=8
MAX_SUB_QUESTIONS=3
CANDIDATES_PER_RETRIEVER=10
RRF_K=60
# Calibrated with scripts/calibrate_gate.py (see README). 0.0 disables the gate.
GATE_THRESHOLD=0.40
LLM_TIMEOUT_SECONDS=20
# Whole-request time budget, keeps every request under the contract's 60 s
REQUEST_BUDGET_SECONDS=45
